<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_HeadPartial" />
</head>
<body>

    <header class="navbar-custom sticky-top">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container">
                <partial name="_HeaderPartial" />

                <div class="d-flex align-items-center gap-2 pt-2 pt-lg-0">
                    <a asp-controller="Login" asp-action="Index" class="btn-login">Đăng nhập</a>
                    <a asp-controller="Register" asp-action="Index" class="btn-register">Đăng ký hội viên</a>
                </div>
            </div>
        </nav>
    </header>

<main class="container py-4 flex-grow-1">
    @RenderBody()
</main>

<partial name="_FooterPartial" />

<partial name="_ScriptsPartial" />
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
