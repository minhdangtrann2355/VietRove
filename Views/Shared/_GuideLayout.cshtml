
@using System.Security.Claims
@using VietRove.Security

@{
    bool isGuide = User.IsInRole(AppRoles.Guide);

    // doc thong tin hoi vien tu claims cua phien dang nhap
    string fullName = "Hội viên";
    if (User.Identity != null && string.IsNullOrEmpty(User.Identity.Name) == false)
    {
        fullName = User.Identity.Name;
    }

    string email = "";
    var emailClaim = User.FindFirst(ClaimTypes.Email);
    if (emailClaim != null && string.IsNullOrEmpty(emailClaim.Value) == false)
    {
        email = emailClaim.Value;
    }

    string statusClaim = "0";
    var statusClaimObj = User.FindFirst("ProfileStatus");

    if (statusClaimObj != null &&
        string.IsNullOrEmpty(statusClaimObj.Value) == false)
    {
        statusClaim = statusClaimObj.Value;
    }

    int currentStatus = 0;
    if (int.TryParse(statusClaim, out int s))
    {
        currentStatus = s;
    }

    string cardNumber = "";
    var cardClaim = User.FindFirst("CardNumber");
    if (cardClaim != null && string.IsNullOrEmpty(cardClaim.Value) == false)
    {
        cardNumber = cardClaim.Value;
    }

    string avatar = "";
    var avatarClaim = User.FindFirst("Avatar");
    if (avatarClaim != null && string.IsNullOrEmpty(avatarClaim.Value) == false)
    {
        avatar = avatarClaim.Value;
    }

    string avatarUrl = "";
    if (string.IsNullOrEmpty(avatar) == false)
    {
        string? url = Url.Action("GetAvatar", "GuideProfile", new { fileName = avatar });

        if (url != null && string.IsNullOrEmpty(url) == false)
        {
            avatarUrl = url;
        }
    }

    string firstLetter = "U";
    if (string.IsNullOrEmpty(fullName) == false)
    {
        firstLetter = fullName.Substring(0, 1);
    }

    string displayCard = "HDV-Chưa cấp";
    if (string.IsNullOrEmpty(cardNumber) == false)
    {
        displayCard = cardNumber;
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_HeadPartial" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="navbar-custom sticky-top">
        <nav class="navbar navbar-expand-lg py-2">
            <div class="container">
                <partial name="_HeaderPartial" />

                <div class="dropdown pt-2 pt-lg-0 navbar-avatar-actions">
                    <button class="btn p-0 border-0 bg-transparent dropdown-toggle no-caret d-flex align-items-center"
                            type="button"
                            id="avatarDropdown"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">
                        @if (string.IsNullOrEmpty(avatarUrl) == false)
                        {
                            <img src="@avatarUrl"
                                 alt="Avatar"
                                 class="avatar-circle"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="avatar-fallback" style="display: none;">
                                @firstLetter
                            </div>
                        }
                        else
                        {
                            <div class="avatar-fallback">
                                @firstLetter
                            </div>
                        }
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end avatar-dropdown-menu"
                        aria-labelledby="avatarDropdown">

                        <li class="dropdown-header-user">
                            <div class="d-flex align-items-center gap-3 mb-2">
                                @if (string.IsNullOrEmpty(avatarUrl) == false)
                                {
                                    <img src="@avatarUrl"
                                         alt="Avatar"
                                         class="rounded-circle border"
                                         style="width: 44px; height: 44px; object-fit: cover; flex-shrink: 0;"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="avatar-fallback"
                                         style="width: 44px; height: 44px; font-size: 18px; display: none; flex-shrink: 0;">
                                        @firstLetter
                                    </div>
                                }
                                else
                                {
                                    <div class="avatar-fallback"
                                         style="width: 44px; height: 44px; font-size: 18px; flex-shrink: 0;">
                                        @firstLetter
                                    </div>
                                }

                                <div style="min-width: 0; flex: 1;">
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="fw-bold text-dark text-truncate"
                                              style="font-size: 15px;"
                                              title="@fullName">
                                            @fullName
                                        </span>

                                        @if (isGuide && currentStatus == 1)
                                        {
                                            <span title="Tài khoản đã duyệt"
                                                  class="d-inline-flex align-items-center flex-shrink-0">
                                                <img src="~/images/bluetick.png"
                                                     alt="Verified"
                                                     style="width: 17px; height: 17px;" />
                                            </span>
                                        }
                                    </div>

                                    @if (currentStatus == 0)
                                    {
                                        <div>
                                            <span class="status-badge-pending">
                                                Đang chờ duyệt
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="text-muted text-truncate"
                                 style="font-size: 13px;"
                                 title="@email">
                                @email
                            </div>

                            <div class="text-secondary text-truncate"
                                 style="font-size: 12.5px; margin-top: 2px;">
                                Mã thẻ: <strong>@displayCard</strong>
                            </div>
                        </li>

                        @if (currentStatus == 1)
                        {
                            <li>
                                <a class="dropdown-item dropdown-item-custom"
                                   asp-controller="GuideProfile"
                                   asp-action="Profile">
                                    Hồ sơ cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dropdown-item-custom"
                                   asp-controller="GuideContract"
                                   asp-action="Contract">
                                    Tạo hợp đồng thỏa thuận
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item dropdown-item-custom"
                                   asp-controller="GuideSettings"
                                   asp-action="Settings">
                                    Cài đặt tài khoản / Bảo mật
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider my-1 text-muted opacity-25">
                            </li>
                        }

                        <li>
                            <form asp-controller="Login"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="dropdown-item dropdown-item-custom text-danger w-100 border-0 bg-transparent text-start">
                                    Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <partial name="_FooterPartial" />

    <partial name="_ScriptsPartial" />

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
