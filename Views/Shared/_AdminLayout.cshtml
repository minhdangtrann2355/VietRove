
@{
    if (ViewData["Title"] == null)
    {
        ViewData["Title"] = "Quản trị VietRove";
    }

    string adminName = "Quản trị viên";

    if (User.Identity != null && string.IsNullOrWhiteSpace(User.Identity.Name) == false)
    {
        adminName = User.Identity.Name;
    }

    string currentController = "";
    string currentAction = "";

    object controllerValue = ViewContext.RouteData.Values["controller"];
    object actionValue = ViewContext.RouteData.Values["action"];

    if (controllerValue != null)
    {
        currentController = controllerValue.ToString();
    }

    if (actionValue != null)
    {
        currentAction = actionValue.ToString();
    }

    string dashboardActive = "";
    string loginHistoryActive = "";

    if (currentController == "Admin" && currentAction == "Dashboard")
    {
        dashboardActive = "active";
    }

    if (currentController == "AdminLoginHistory" && currentAction == "Index")
    {
        loginHistoryActive = "active";
    }

    string guideReviewActive = "";

    if (currentController == "AdminGuideReview" &&
        (currentAction == "Index" || currentAction == "Detail"))
    {
        guideReviewActive = "active";
    }

    string competencyReviewActive = "";

    if (currentController == "AdminCompetencyReview" &&
        (currentAction == "Index" || currentAction == "Review"))
    {
        competencyReviewActive = "active";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VietRove Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/Admin/admin.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="admin-wrapper d-flex">

        <aside class="admin-sidebar" id="adminSidebar">
            <a asp-controller="Admin"
               asp-action="Dashboard"
               class="admin-brand">
                <div>
                    <span class="admin-brand-name">VietRove</span>
                    <span class="admin-brand-subtitle">ADMINISTRATION</span>
                </div>
            </a>

            <div class="admin-sidebar-content">
                <div class="admin-menu-label">Tổng quan</div>

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="admin-menu-link @dashboardActive">
                    <span>Bảng điều khiển</span>
                </a>

                <div class="admin-menu-label">Quản lý hệ thống</div>

               <a asp-controller="AdminGuideReview"
                    asp-action="Index"
                    class="admin-menu-link @guideReviewActive">
                        <span>Xét duyệt hồ sơ HDV</span>
                </a>

                <a asp-controller="AdminCompetencyReview"
                    asp-action="Index"
                    class="admin-menu-link @competencyReviewActive">
                        <span>Xét duyệt năng lực</span>
                </a>

                <div class="admin-menu-disabled"
                     title="Chức năng đang được xây dựng">
                    <span>Quản lý hướng dẫn viên</span>
                </div>

                <div class="admin-menu-disabled"
                     title="Chức năng đang được xây dựng">
                    <span>Báo cáo vi phạm</span>
                </div>

                <div class="admin-menu-label">Theo dõi hoạt động</div>

                <a asp-controller="AdminLoginHistory"
                   asp-action="Index"
                   class="admin-menu-link @loginHistoryActive">
                    <span>Lịch sử đăng nhập</span>
                </a>

                <div class="admin-menu-label">Nội dung</div>

                <div class="admin-menu-disabled"
                     title="Chức năng đang được xây dựng">
                    <span>Quản lý bài viết</span>
                </div>

                <div class="admin-menu-disabled"
                     title="Chức năng đang được xây dựng">
                    <span>Quản lý danh mục</span>
                </div>
            </div>

            <div class="admin-sidebar-footer">
                VietRove Administration<br />
                Phiên bản quản trị hệ thống
            </div>
        </aside>

        <div class="admin-sidebar-overlay" id="adminSidebarOverlay"></div>

        <div class="admin-main">
            <header class="admin-header">
                <div class="d-flex align-items-center gap-3">
                    <button type="button"
                            class="admin-mobile-toggle"
                            id="adminMobileToggle"
                            aria-label="Mở menu"
                            aria-controls="adminSidebar"
                            aria-expanded="false">
                        Menu
                    </button>

                    <div>
                        <h1 class="admin-header-title">@ViewData["Title"]</h1>
                        <div class="admin-header-subtitle">
                            Hệ thống quản trị VietRove
                        </div>
                    </div>
                </div>

                <div class="admin-user-info">
                    <div class="text-end d-none d-sm-block">
                        <div class="admin-user-name">@adminName</div>
                        <div class="admin-user-role">Quản trị viên</div>
                    </div>

                    <form asp-controller="Login"
                          asp-action="Logout"
                          method="post"
                          class="m-0">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="admin-logout-btn">
                            Đăng xuất
                        </button>
                    </form>
                </div>
            </header>

            <main class="admin-content">
                @RenderBody()
            </main>

            <footer class="admin-footer">
                © @DateTime.Now.Year VietRove. Hệ thống quản trị.
            </footer>
        </div>
    </div>

    <form id="adminAntiForgeryForm" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <partial name="_ScriptsPartial" />

    <script src="~/js/admin.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
