
@model List<VietRove.Entities.Article>

@{
    ViewData["Title"] = "Trang chủ - Mạng lưới Hướng Dẫn Viên Du Lịch";
}

<link rel="stylesheet" href="~/css/Guest/home.css" asp-append-version="true" />

<section class="hero-banner">
    <div class="container-fluid px-0">
        <h1 class="hero-title">
            Mạng Lưới Hướng Dẫn Viên Du Lịch Việt Nam
        </h1>

        <p class="hero-slogan">
            Kết nối đam mê – Dẫn lối hành trình – Nâng tầm chất lượng dịch vụ hướng dẫn viên du lịch chuyên nghiệp toàn quốc.
        </p>

        <a asp-controller="GuestGuide" asp-action="Guides" class="hero-cta-btn">
            Tra cứu HDV ngay
        </a>
    </div>
</section>

<section class="home-articles">
    <div class="home-section-heading">
        <h2>TIN TỨC & HOẠT ĐỘNG HIỆP HỘI</h2>

        <p>
            Cập nhật các thông tin, thông báo chính thức từ Hiệp hội Hướng dẫn viên Du lịch Việt Nam
        </p>

        <div class="heading-underline"></div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var article in Model)
            {
                string articleTypeText = "Tin tức";

                if (article.ArticleType == 2)
                {
                    articleTypeText = "Trải nghiệm du lịch";
                }
                else if (article.ArticleType == 3)
                {
                    articleTypeText = "Thông báo";
                }

                string publishedAtText = article.CreatedAt.ToString("dd/MM/yyyy HH:mm");

                if (article.PublishedAt.HasValue)
                {
                    publishedAtText = article.PublishedAt.Value.ToString("dd/MM/yyyy HH:mm");
                }

                string displayContent = "";

                if (!string.IsNullOrEmpty(article.Content))
                {
                    displayContent = article.Content;

                    if (displayContent.Length > 120)
                    {
                        displayContent = displayContent.Substring(0, 120) + "...";
                    }
                }

                <div class="col-md-4">
                    <div class="card article-card h-100 border-0 shadow-sm">

                        @if (!string.IsNullOrWhiteSpace(article.Thumbnail))
                        {
                            <img src="@Url.Action("ArticleThumbnail", "GuestArticle", new { articleId = article.ArticleId })"
                                 class="article-thumbnail"
                                 alt="@article.Title" />
                        }
                        else
                        {
                            <div class="article-thumbnail-placeholder">
                                <span>Bản tin Hiệp hội</span>
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-3">
                            <span class="article-type-badge">
                                @articleTypeText
                            </span>

                            <h5 class="article-title">
                                <a asp-controller="GuestArticle"
                                   asp-action="ArticleDetail"
                                   asp-route-id="@article.ArticleId"
                                   class="article-title-link">
                                    @article.Title
                                </a>
                            </h5>

                            <p class="article-published-date">
                                @publishedAtText
                            </p>

                            <p class="article-content-preview">
                                @displayContent
                            </p>

                            <a asp-controller="GuestArticle"
                               asp-action="ArticleDetail"
                               asp-route-id="@article.ArticleId"
                               class="article-detail-link">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="article-empty-state">
                    <p>Hiện chưa có bài viết nào được đăng tải.</p>
                </div>
            </div>
        }
    </div>
</section>
