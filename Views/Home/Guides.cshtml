@model List<VietRove.Entities.GuideProfile>
@{
    ViewData["Title"] = "Tìm kiếm Hướng Dẫn Viên";
    string currentKeyword = "";
    if (ViewBag.Keyword != null)
    {
        currentKeyword = ViewBag.Keyword.ToString();
    }

    string currentCardType = "";
    if (ViewBag.CardType != null)
    {
        currentCardType = ViewBag.CardType.ToString();
    }

    int currentProvinceId = 0;
    if (ViewBag.ProvinceId != null)
    {
        currentProvinceId = (int)ViewBag.ProvinceId;
    }

    int currentLanguageId = 0;
    if (ViewBag.LanguageId != null)
    {
        currentLanguageId = (int)ViewBag.LanguageId;
    }

    List<VietRove.Entities.Category> provinces = new List<VietRove.Entities.Category>();
    if (ViewBag.Provinces != null)
    {
        provinces = ViewBag.Provinces;
    }

    List<VietRove.Entities.Category> languages = new List<VietRove.Entities.Category>();
    if (ViewBag.Languages != null)
    {
        languages = ViewBag.Languages;
    }
    Dictionary<int, string> activityProvinces = new Dictionary<int, string>();
    if (ViewBag.ActivityProvinces != null)
    {
        activityProvinces = ViewBag.ActivityProvinces;
    }
}

<div class="mb-4 text-center">
    <h2 class="fw-bold" style="color: #1e3a8a;">TÌM KIẾM HỘI VIÊN HƯỚNG DẪN VIÊN</h2>
    <p class="text-muted small">Danh sách các hội viên chính thức đã được Hiệp hội kiểm duyệt và xác thực thông tin hành nghề</p>
    <div style="height: 3px; width: 60px; background: #2563eb; margin: 10px auto 0;"></div>
</div>

<div class="card border-0 shadow-sm mb-4 p-3" style="background: #ffffff; border-radius: 8px;">
    <form method="get" asp-controller="Home" asp-action="Guides" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="keyword" value="@currentKeyword" class="form-control" placeholder="Tên, địa phương hoặc mã thẻ..." />
        </div>
        <div class="col-md-2">
            <select name="cardType" class="form-select">
                <option value="">-- Tất cả loại thẻ --</option>
                @if (currentCardType == "Nội địa")
                {
                    <option value="Nội địa" selected>HDV Nội địa</option>
                }
                else
                {
                    <option value="Nội địa">HDV Nội địa</option>
                }
                @if (currentCardType == "Quốc tế")
                {
                    <option value="Quốc tế" selected>HDV Quốc tế</option>
                }
                else
                {
                    <option value="Quốc tế">HDV Quốc tế</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="provinceId" class="form-select">
                <option value="0">-- Tỉnh/thành --</option>
                @foreach (var province in provinces)
                {
                    if (province.CategoryId == currentProvinceId)
                    {
                        <option value="@province.CategoryId" selected>@province.CategoryName</option>
                    }
                    else
                    {
                        <option value="@province.CategoryId">@province.CategoryName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="languageId" class="form-select">
                <option value="0">-- Ngoại ngữ --</option>
                @foreach (var language in languages)
                {
                    if (language.CategoryId == currentLanguageId)
                    {
                        <option value="@language.CategoryId" selected>@language.CategoryName</option>
                    }
                    else
                    {
                        <option value="@language.CategoryId">@language.CategoryName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn w-100 text-white fw-bold" style="background-color: #1d4ed8;">
                Tìm kiếm
            </button>
        </div>
    </form>
</div>

<div class="row g-4">
    @if (Model != null && Model.Count > 0)
    {
        foreach (var guide in Model)
        {
            string firstLetter = "G";
            if (string.IsNullOrEmpty(guide.FullName) == false)
            {
                firstLetter = guide.FullName.Substring(0, 1).ToUpper();
            }

            string displayAddress = "Đang cập nhật";
            if (string.IsNullOrEmpty(guide.Address) == false)
            {
                displayAddress = guide.Address;
            }

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm text-center p-3" style="border-radius: 8px; background: #ffffff;">
                    <div class="mb-3 mt-2">
                        @if (string.IsNullOrEmpty(guide.Avatar) == false)
                        {
                            <img src="@Url.Action("GetAvatar", "Home", new { fileName = guide.Avatar })" class="rounded-circle shadow-sm" alt="@guide.FullName" style="width: 90px; height: 90px; object-fit: cover; border: 2px solid #e5e7eb;" />
                        }
                        else
                        {
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white fw-bold" style="width: 90px; height: 90px; font-size: 28px; background: #3b82f6;">
                                @firstLetter
                            </div>
                        }
                    </div>

                    <div class="card-body p-0 d-flex flex-column">
                        <h5 class="fw-bold mb-1" style="color: #1f2937; font-size: 16px;">@guide.FullName</h5>
                        <p class="mb-2" style="font-size: 13px; color: #2563eb; font-weight: 600;">
                            Thẻ
                            @if (guide.CardType != null)
                            {
                                @guide.CardType.CategoryName
                            }
                            else
                            {
                                <span>Chưa cập nhật</span>
                            }
                            (@guide.CardNumber)
                        </p>
                        <hr class="my-2" style="border-color: #f3f4f6;" />

                        <div class="text-start small text-muted px-2 mb-3">
                            <p class="mb-1"><strong>Kinh nghiệm:</strong> @guide.ExperienceYears năm</p>
                            @{
                                string activityProvince = "Đang cập nhật";
                                if (activityProvinces.ContainsKey(guide.GuideId))
                                {
                                    activityProvince = activityProvinces[guide.GuideId];
                                }
                            }
                            <p class="mb-1"><strong>Tỉnh thành hoạt động:</strong> @activityProvince</p>
                            
                           @{
                                string displayEmail = "Đang cập nhật";
                                if (!string.IsNullOrEmpty(guide.ContactEmail))
                                {
                                    displayEmail = guide.ContactEmail;
                                }
                            }
                            <p class="mb-0"><strong>Liên hệ:</strong> <span class="text-dark">@displayEmail</span></p>
                        </div>

                        <div class="mt-auto">
                            <a asp-controller="Home" asp-action="GuideProfile" asp-route-id="@guide.GuideId" class="btn btn-sm btn-outline-primary mb-2 w-100">Xem hồ sơ</a>
                            <span class="badge" style="background-color: #ecfdf5; color: #059669; font-weight: 500; font-size: 12px; padding: 6px 12px; border-radius: 20px;">
                                ✓ Đã được kiểm duyệt
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="p-4 rounded bg-white shadow-sm border" style="max-width: 500px; margin: 0 auto;">
                <p class="text-muted mb-0">Không tìm thấy hướng dẫn viên nào phù hợp với yêu cầu tìm kiếm.</p>
            </div>
        </div>
    }
</div>
