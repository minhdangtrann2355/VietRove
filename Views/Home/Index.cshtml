@model List<VietRove.Entities.Article>
@{
    ViewData["Title"] = "Trang chủ - Mạng lưới Hướng Dẫn Viên Du Lịch";
}

<style>
    .hero-banner {
        position: relative;
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.72) 0%, rgba(30, 58, 138, 0.78) 100%), 
                    url('https://images.unsplash.com/photo-1528127269322-539801943592?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D') center/cover no-repeat;
        padding: 75px 24px;
        text-align: center;
        color: #ffffff;
        margin-bottom: 45px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .hero-title {
        font-size: 2.3rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        line-height: 1.25;
        margin-bottom: 14px;
        text-shadow: 0 2px 6px rgba(0, 0, 0, 0.35);
    }

    .hero-slogan {
        font-size: 1.15rem;
        font-weight: 400;
        color: #e2e8f0;
        max-width: 680px;
        margin: 0 auto 28px auto;
        line-height: 1.6;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
    }

    .hero-cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background-color: #2563eb;
        color: #ffffff !important;
        font-size: 15px;
        font-weight: 600;
        padding: 13px 32px;
        border-radius: 8px;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.45);
        transition: all 0.25s ease;
    }

    .hero-cta-btn:hover {
        background-color: #1d4ed8;
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(37, 99, 235, 0.6);
    }

(< 768px) */
    @@media (max-width: 768px) {
        .hero-banner {
            padding: 48px 16px;
            border-radius: 8px;
            margin-bottom: 35px;
        }

        .hero-title {
            font-size: 1.65rem;
            line-height: 1.3;
        }

        .hero-slogan {
            font-size: 0.98rem;
            margin-bottom: 22px;
        }

        .hero-cta-btn {
            width: 100%;
            max-width: 280px;
            padding: 12px 20px;
            font-size: 14px;
        }
    }
</style>

<section class="hero-banner">
    <div class="container-fluid px-0">
        <h1 class="hero-title">
            Mạng Lưới Hướng Dẫn Viên Du Lịch Việt Nam
        </h1>
        <p class="hero-slogan">
            Kết nối đam mê – Dẫn lối hành trình – Nâng tầm chất lượng dịch vụ hướng dẫn viên du lịch chuyên nghiệp toàn quốc.
        </p>
        <a asp-controller="Home" asp-action="Guides" class="hero-cta-btn">
            <svg style="width: 18px; height: 18px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            Tra cứu HDV ngay
        </a>
    </div>
</section>

<div class="mb-4 text-center">
    <h2 class="fw-bold" style="color: #1e3a8a;">TIN TỨC & HOẠT ĐỘNG HIỆP HỘI</h2>
    <p class="text-muted small">Cập nhật các thông tin, thông báo chính thức từ Hiệp hội Hướng dẫn viên Du lịch Việt Nam</p>
    <div style="height: 3px; width: 60px; background: #2563eb; margin: 10px auto 0;"></div>
</div>

<div class="row g-4">
    @if (Model != null && Model.Count > 0)
    {
        foreach (var article in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm" style="border-radius: 8px; overflow: hidden; background: #ffffff;">
                    @if (!string.IsNullOrEmpty(article.Thumbnail))
                    {
                        <img src="@Url.Action("GetThumbnail", "Home", new { fileName = article.Thumbnail })" class="card-img-top" alt="@article.Title" style="height: 200px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center text-muted" style="height: 200px; background: #f3f4f6;">
                            <span class="small">Bản tin Hiệp hội</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column p-3">
                        <span class="badge align-self-start mb-2" style="background-color: #eff6ff; color: #1d4ed8; font-weight: 500;">Tin tức</span>
                        <h5 class="card-title fw-bold fs-6 mb-2" style="color: #1f2937; line-height: 1.4;">@article.Title</h5>
                        <p class="card-text text-muted mb-2" style="font-size: 12px;">
                            @(article.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))
                        </p>
                        <p class="card-text text-secondary small flex-grow-1" style="line-height: 1.5;">
                            @{
                                string displayContent = article.Content ?? string.Empty;
                                if (displayContent.Length > 120)
                                {
                                    displayContent = displayContent.Substring(0, 120) + "...";
                                }
                            }
                            @displayContent
                        </p>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <div class="p-4 rounded bg-white shadow-sm border" style="max-width: 500px; margin: 0 auto;">
                <p class="text-muted mb-0">Hiện chưa có bài viết tin tức nào được đăng tải.</p>
            </div>
        </div>
    }
</div>
