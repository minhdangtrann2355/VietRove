@model VietRove.Models.GuideProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ hướng dẫn viên";
    string provinceName = "Đang cập nhật";
    List<string> languages = new List<string>();
    foreach (var category in Model.SelectedCategories)
    {
        if (category.CategoryType == "Province")
        {
            provinceName = category.CategoryName;
        }
        else if (category.CategoryType == "Language")
        {
            languages.Add(category.CategoryName);
        }
    }
}

<div class="mb-4 text-center">
    <h2 class="fw-bold" style="color: #1e3a8a;">HỒ SƠ HƯỚNG DẪN VIÊN</h2>
    <p class="text-muted small">Thông tin công khai của hội viên đã được Hiệp hội xác thực</p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm p-4">
            <div class="row align-items-center g-4">
                <div class="col-md-4 text-center">
                    @if (string.IsNullOrWhiteSpace(Model.Profile.Avatar) == false)
                    {
                        <img src="@Url.Action("GetAvatar", "Home", new { fileName = Model.Profile.Avatar })" alt="@Model.Profile.FullName" class="rounded-circle shadow-sm" style="width: 150px; height: 150px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center text-white fw-bold" style="width: 150px; height: 150px; font-size: 48px; background: #2563eb;">
                            @Model.Profile.FullName.Substring(0, 1)
                        </div>
                    }
                </div>
                <div class="col-md-8">
                    <h3 class="fw-bold mb-2">@Model.Profile.FullName</h3>
                    <span class="badge rounded-pill mb-3" style="background-color: #ecfdf5; color: #059669;">✓ Đã xác thực</span>
                    <p class="mb-1"><strong>Mã thẻ:</strong> @Model.Profile.CardNumber</p>
                    <p class="mb-1"><strong>Loại thẻ:</strong>
                    @if (Model.Profile.CardType != null)
                    {
                        @Model.Profile.CardType.CategoryName
                    }
                    else
                    {
                        <span>Chưa cập nhật</span>
                    }
                    </p>
                    <p class="mb-1"><strong>Kinh nghiệm:</strong> @Model.Profile.ExperienceYears năm</p>
                    <p class="mb-0"><strong>Email liên hệ:</strong> <a href="mailto:@Model.Profile.ContactEmail">@Model.Profile.ContactEmail</a></p>
                </div>
            </div>
            <hr class="my-4" />
            <div class="row g-3">
                <div class="col-md-6"><strong>Tỉnh thành hoạt động:</strong><br />@provinceName</div>
                <div class="col-md-6"><strong>Ngoại ngữ:</strong><br />
                    @if (languages.Count > 0)
                    {
                        @string.Join(", ", languages)
                    }
                    else
                    {
                        <span>Đang cập nhật</span>
                    }
                </div>
                <div class="col-12"><strong>Địa chỉ liên hệ:</strong><br />@Model.Profile.Address</div>
            </div>
            <div class="border-top mt-4 pt-4">
                <h5 class="fw-bold mb-3" style="color: #1e3a8a;">Kinh nghiệm dẫn tour</h5>
                @if (Model.GuideExperiences.Count > 0)
                {
                    foreach (var experience in Model.GuideExperiences)
                    {
                        <div class="border rounded p-3 mb-3">
                            <h6 class="fw-bold mb-1">@experience.Title</h6>
                            <p class="mb-0 small">@experience.Description</p>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small mb-0">Hướng dẫn viên chưa công khai kinh nghiệm dẫn tour chi tiết.</p>
                }
            </div>
            <div class="alert alert-light border mt-4 mb-0 small">
                Hệ thống không công khai CCCD, ảnh giấy tờ, chứng chỉ gốc và các thông tin nhạy cảm khác.
            </div>
        </div>
    </div>
</div>
