
@{
    ViewData["Title"] = "Lịch sử đăng nhập";
}

<div class="container-fluid py-4"
     id="loginHistoryContainer"
     data-url="@Url.Action("Search", "AdminLoginHistory")">

    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">Lịch sử đăng nhập</h3>
        <p class="text-muted mb-0">
            Theo dõi lịch sử đăng nhập của Admin và Hướng dẫn viên.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3 p-md-4">

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6 col-lg-3">
                    <label for="searchInput" class="form-label fw-semibold">
                        Email
                    </label>

                    <input type="text"
                           id="searchInput"
                           class="form-control"
                           maxlength="254"
                           placeholder="Nhập email cần tìm">
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label for="roleInput" class="form-label fw-semibold">
                        Vai trò
                    </label>

                    <select id="roleInput" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="1">Admin</option>
                        <option value="2">Guide</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label for="fromDateInput" class="form-label fw-semibold">
                        Từ ngày
                    </label>

                    <input type="date"
                           id="fromDateInput"
                           class="form-control">
                </div>

                <div class="col-12 col-md-6 col-lg-2">
                    <label for="toDateInput" class="form-label fw-semibold">
                        Đến ngày
                    </label>

                    <input type="date"
                           id="toDateInput"
                           class="form-control">
                </div>

                <div class="col-12 col-lg-3 d-flex align-items-end gap-2">
                    <button type="button"
                            id="searchButton"
                            class="btn btn-primary flex-fill text-nowrap">
                        Tìm kiếm
                    </button>

                    <button type="button"
                            id="resetButton"
                            class="btn btn-outline-primary text-nowrap">
                        Xóa bộ lọc
                    </button>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                <span class="text-muted small" id="recordInfo">
                    Đang tải dữ liệu...
                </span>

                <button type="button"
                        id="refreshButton"
                        class="btn btn-sm btn-primary text-nowrap flex-shrink-0 align-self-start align-self-sm-auto">
                    Làm mới
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 70px;">STT</th>
                            <th>Email</th>
                            <th style="width: 150px;">Vai trò</th>
                            <th style="width: 210px;">Thời gian đăng nhập</th>
                        </tr>
                    </thead>

                    <tbody id="historyTable">
                        <tr>
                            <td colspan="4"
                                class="text-center py-4 text-muted">
                                Đang tải dữ liệu...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-4">
                <span class="text-muted small" id="pageInfo"></span>

                <div class="btn-group" id="pagination"></div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-login-history.js"
            asp-append-version="true"></script>
}
