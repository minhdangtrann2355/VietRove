
@{
    ViewData["Title"] = "Quản lý hướng dẫn viên";
}

<div class="container-fluid py-4 guide-management-page"
     id="guideManagementContainer"
     data-search-url="@Url.Action("Search", "AdminGuideManagement")"
     data-detail-url="@Url.Action("Detail", "AdminGuideManagement")"
     data-lock-url="@Url.Action("Lock", "AdminGuideManagement")"
     data-unlock-url="@Url.Action("Unlock", "AdminGuideManagement")">

    <div class="mb-4">
        <h3 class="fw-bold text-dark mb-1">Quản lý hướng dẫn viên</h3>
        <p class="text-muted mb-0">
            Theo dõi thông tin, trạng thái tài khoản và hồ sơ hướng dẫn viên.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-3 p-md-4">

            <div class="row g-3 mb-4">
                <div class="col-12 col-md-6 col-lg-4">
                    <label for="guideSearchInput" class="form-label fw-semibold">
                        Tìm kiếm
                    </label>

                    <input type="text"
                           id="guideSearchInput"
                           class="form-control"
                           maxlength="254"
                           placeholder="Họ tên, email hoặc số điện thoại">
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="accountStatusInput" class="form-label fw-semibold">
                        Trạng thái tài khoản
                    </label>

                    <select id="accountStatusInput" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="1">Đang hoạt động</option>
                        <option value="0">Đã khóa</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="profileStatusInput" class="form-label fw-semibold">
                        Trạng thái hồ sơ
                    </label>

                    <select id="profileStatusInput" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="0">Chờ duyệt</option>
                        <option value="1">Đã duyệt</option>
                        <option value="2">Bị từ chối</option>
                        <option value="3">Đã khóa</option>
                        <option value="4">Yêu cầu chỉnh sửa</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-2 d-flex align-items-end gap-2">
                    <button type="button"
                            id="guideSearchButton"
                            class="btn btn-primary flex-fill text-nowrap">
                        Tìm kiếm
                    </button>

                    <button type="button"
                            id="guideResetButton"
                            class="btn btn-outline-primary text-nowrap">
                        Xóa lọc
                    </button>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                <span class="text-muted small" id="guideRecordInfo">
                    Đang tải dữ liệu...
                </span>

                <button type="button"
                        id="guideRefreshButton"
                        class="btn btn-sm btn-primary text-nowrap flex-shrink-0 align-self-start align-self-sm-auto">
                    Làm mới
                </button>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 guide-management-table">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 65px;">STT</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th style="width: 145px;">Số điện thoại</th>
                            <th style="width: 145px;">Tài khoản</th>
                            <th style="width: 165px;">Hồ sơ</th>
                            <th style="width: 170px;">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody id="guideManagementTable">
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Đang tải dữ liệu...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-4">
                <span class="text-muted small" id="guidePageInfo"></span>

                <div class="btn-group" id="guidePagination"></div>
            </div>
        </div>
    </div>

    <form id="guideManagementTokenForm">
        @Html.AntiForgeryToken()
    </form>
</div>

<div class="modal fade" id="lockGuideModal" tabindex="-1"
     aria-labelledby="lockGuideModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="lockGuideModalLabel">
                    Khóa tài khoản hướng dẫn viên
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Đóng"></button>
            </div>

            <div class="modal-body">
                <label for="lockReasonInput" class="form-label fw-semibold">
                    Lý do khóa
                </label>

                <textarea id="lockReasonInput"
                          class="form-control"
                          rows="4"
                          maxlength="500"
                          placeholder="Nhập lý do khóa tài khoản"></textarea>

                <div class="d-flex justify-content-between mt-1">
                    <span class="text-danger small" id="lockReasonError"></span>
                    <span class="text-muted small" id="lockReasonCounter">0/500</span>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Hủy
                </button>

                <button type="button"
                        class="btn btn-primary"
                        id="confirmLockButton">
                    Xác nhận khóa
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/Admin/admin-guide-management.css"
          asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/Admin/admin-guide-management.js"
            asp-append-version="true"></script>
}
