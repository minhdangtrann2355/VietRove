
@model VietRove.Models.Guide.GuideAccountSettingsViewModel

@{
    ViewData["Title"] = "Cài đặt tài khoản / Bảo mật";
}

<div class="container py-5 guide-settings">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">CÀI ĐẶT TÀI KHOẢN</h2>
        <p class="text-muted mb-0">Quản lý thông tin và bảo mật tài khoản hội viên.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold settings-heading mb-3">Thông tin tài khoản</h5>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label text-muted">Email đăng nhập</label>
                    <input type="email" class="form-control" value="@Model.Email" readonly />
                </div>

                <div class="col-md-6">
                    <label class="form-label text-muted">Ngày tạo tài khoản</label>
                    <input type="text" class="form-control" value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")" readonly />
                </div>
            </div>

            <p class="small text-muted mt-3 mb-0">
                Email đăng nhập hiện chưa hỗ trợ thay đổi.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h5 class="fw-bold settings-heading mb-2">Đổi mật khẩu</h5>
            <p class="text-muted small mb-4">
                Nhập mật khẩu hiện tại để xác nhận trước khi thay đổi mật khẩu mới.
            </p>

            <form asp-controller="Guide" asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                        <input name="CurrentPassword"
                               type="password"
                               class="form-control"
                               autocomplete="current-password"
                               required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Mật khẩu mới <span class="text-danger">*</span></label>
                        <input name="NewPassword"
                               type="password"
                               class="form-control"
                               minlength="8"
                               maxlength="128"
                               autocomplete="new-password"
                               required />
                        <div class="form-text">Mật khẩu có từ 8 đến 128 ký tự.</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <input name="ConfirmNewPassword"
                               type="password"
                               class="form-control"
                               minlength="8"
                               maxlength="128"
                               autocomplete="new-password"
                               required />
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit" class="btn btn-primary fw-bold">
                            Đổi mật khẩu
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/guide-settings.css" asp-append-version="true" />
